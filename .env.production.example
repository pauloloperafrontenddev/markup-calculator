# Production environment — copy to .env.production and fill in real values.
# .env.production is gitignored and must NEVER be committed.
#
# VITE_ vars are baked into the client JS bundle at `docker compose build` time
# via docker-compose.prod.yml build.args. They must also be in this file so
# the runtime environment reflects the same values.
#
# Deployment checklist:
#   1. Copy this file to .env.production
#   2. Fill in all values
#   3. Run: docker compose -f docker-compose.prod.yml up --build -d

# ── Supabase (cloud project) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
