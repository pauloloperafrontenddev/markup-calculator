# Supabase — copy this to .env.local and fill in your values
# For local development: run `npx supabase start` then paste values from its output
# For production: use your Supabase project's URL and anon key

# ── Supabase (cloud project) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
